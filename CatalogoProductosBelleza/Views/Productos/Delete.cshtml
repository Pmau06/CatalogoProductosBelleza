@model CatalogoProductosBelleza.Models.Producto

@{
    ViewData["Title"] = "Eliminar Producto";
}

<div class="container mt-5">

    <h2 class="text-center text-danger">
        Eliminar Producto de Belleza
    </h2>

    <p class="text-center mt-3">
        ¿Está seguro de que desea eliminar este producto?
    </p>

    <div class="alert alert-warning">
        Atención: Esta acción eliminará el producto
        de la base de datos.
    </div>

    <div class="card shadow-sm mt-4">
        <div class="card-body">

            <h4 class="card-title">@Model.Nombre</h4>

            <hr />

            <p><strong>ID:</strong> @Model.Id</p>

            <p><strong>Categoría:</strong> @Model.Categoria</p>

            <p><strong>Marca:</strong> @Model.Marca</p>

            <p>
                <strong>Precio:</strong>
                ₡@Model.Precio.ToString("N2")
            </p>

            <p><strong>Cantidad:</strong> @Model.Cantidad</p>

            <p>
                <strong>Descripción:</strong>
                @Model.Descripcion
            </p>

            <form asp-controller="Productos"
                  asp-action="Delete"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       value="@Model.Id" />

                <div class="text-center mt-4">

                    <button type="submit"
                            class="btn btn-danger">
                        Confirmar Eliminación
                    </button>

                    <a asp-controller="Productos"
                       asp-action="Index"
                       class="btn btn-secondary">
                        Cancelar
                    </a>

                </div>

            </form>

        </div>
    </div>

</div>
