@model CatalogoProductosBelleza.Models.Producto

@{
    ViewData["Title"] = "Editar Producto";
}

<div class="container mt-4">

    <h2 class="text-center mb-4">
        Editar Producto de Belleza
    </h2>

    <p class="text-center">
        Modifique los datos del producto seleccionado.
    </p>

    <form asp-controller="Productos"
          asp-action="Edit"
          asp-route-id="@Model.Id"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="Id" />

        <div asp-validation-summary="All"
             class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Nombre" class="form-label"></label>
            <input asp-for="Nombre" class="form-control" />
            <span asp-validation-for="Nombre"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Categoria" class="form-label"></label>
            <input asp-for="Categoria" class="form-control" />
            <span asp-validation-for="Categoria"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Marca" class="form-label"></label>
            <input asp-for="Marca" class="form-control" />
            <span asp-validation-for="Marca"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Precio" class="form-label"></label>
            <input asp-for="Precio"
                   type="number"
                   step="0.01"
                   min="0"
                   class="form-control" />
            <span asp-validation-for="Precio"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Cantidad" class="form-label"></label>
            <input asp-for="Cantidad"
                   type="number"
                   min="0"
                   class="form-control" />
            <span asp-validation-for="Cantidad"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Descripcion"
                   class="form-label"></label>
            <textarea asp-for="Descripcion"
                      class="form-control"
                      rows="3"></textarea>
            <span asp-validation-for="Descripcion"
                  class="text-danger"></span>
        </div>

        <div class="text-center mt-4">
            <button type="submit"
                    class="btn btn-primary">
                Guardar Cambios
            </button>

            <a asp-controller="Productos"
               asp-action="Index"
               class="btn btn-secondary">
                Cancelar
            </a>
        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
